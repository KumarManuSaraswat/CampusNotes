NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_ENABLED=false
MAX_FILE_MB=10

# Server-only. Create a Groq key, then set AI_ENABLED=true.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional rollback: set AI_PROVIDER=gemini and configure these instead.
GEMINI_API_KEY=
GEMINI_MODEL=
# Community-request suggestions use Gemini independently of AI_PROVIDER.
REQUEST_RECOMMENDATIONS_ENABLED=true
# Optional override; otherwise uses GEMINI_MODEL.
GEMINI_RECOMMENDATION_MODEL=
AI_MAX_CONCURRENT=1
VISION_TIMEOUT_MS=150000
